# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
# Só variáveis com EXPO_PUBLIC_ chegam ao app, e todas são públicas.
# A chave secreta (service_role / sb_secret_...) NUNCA entra aqui: só nas Edge Functions.

# Local: http://<IP-do-computador>:54321 (veja com: npx supabase status)
# Nuvem: https://<id-do-projeto>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Chave pública ("publishable", antiga "anon"): sb_publishable_...
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
