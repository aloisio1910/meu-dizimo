# Copie para supabase/functions/.env (fora do Git). No Supabase local, o
# valor precisa ser igual ao do segredo_das_funcoes em supabase/seed.sql.
SEGREDO_DAS_FUNCOES=segredo-local-das-funcoes

# E-mails (D-097). No local vão para o Mailpit (rede interna do Docker);
# sem MAILPIT_URL, saem pelo Resend com a chave abaixo (fora do Git).
MAILPIT_URL=http://supabase_inbucket_meu-dizimo:8025
RESEND_API_KEY=

# Links das lojas no e-mail de convite (vazio enquanto o app não é publicado).
LINK_ANDROID=
LINK_IPHONE=
